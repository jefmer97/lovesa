# ==========================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN (VPS / Coolify / Docker Compose)
# Copia este archivo como `.env` en la raíz antes de desplegar
# ==========================================

# 1. URL pública de tu Backend (sin barra final)
# - Si usas dominio con HTTPS en Coolify/Caddy: https://api.tudominio.com
# - Si usas directo la IP de tu VPS: http://TU_IP_DEL_VPS:3001
NEXT_PUBLIC_API_URL=https://api.tudominio.com
BACKEND_URL=https://api.tudominio.com

# 2. Seguridad JWT del Backend (pon una cadena larga y aleatoria)
JWT_SECRET=pon_aqui_una_clave_secreta_larga_y_segura_2026

# 3. Conexión a Base de Datos (por defecto usa el contenedor interno de MongoDB)
MONGODB_URI=mongodb://mongodb:27017/lovesa

# 4. API Key de Google Gemini para el chat de IA
GOOGLE_GENERATIVE_AI_API_KEY=tu_api_key_de_gemini_aqui
